brew "fd"
brew "fzf"

# tmux: prefix + G
brew "lazygit"

# zsh prompt & plugins (wired up in zsh/zshrc)
brew "pure"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
