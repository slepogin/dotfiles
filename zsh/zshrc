# ~/.zshrc — managed by dotfiles (zsh/zshrc).
# Machine-specific config goes in ~/.zshrc.local, sourced near the bottom.

# ── path ───────────────────────────────────────────────────────
typeset -U path                       # keep entries unique
path=("$HOME/.local/bin" $path)

# Brew shellenv normally runs in ~/.zprofile; cover non-login shells too.
if [[ -z ${HOMEBREW_PREFIX:-} && -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi
brew_share="${HOMEBREW_PREFIX:-/opt/homebrew}/share"

# ── history ────────────────────────────────────────────────────
HISTFILE="$HOME/.zsh_history"
HISTSIZE=200000
SAVEHIST=200000
setopt EXTENDED_HISTORY      # сохранять время команды
setopt SHARE_HISTORY         # писать сразу после команды + видеть команды из других вкладок
setopt HIST_IGNORE_ALL_DUPS  # без дублей
setopt HIST_IGNORE_SPACE     # команда с пробелом в начале не попадёт в историю (для секретов)
setopt HIST_REDUCE_BLANKS
setopt HIST_FIND_NO_DUPS

# ── completion ─────────────────────────────────────────────────
fpath+=("$brew_share/zsh/site-functions")
autoload -Uz compinit && compinit
zstyle ':completion:*' menu select    # arrow-key menu for candidates
# case-insensitive + substring matching
zstyle ':completion:*' matcher-list '' 'm:{[:lower:][:upper:]}={[:upper:][:lower:]}' '+l:|=* r:|=*'

# ── prompt (pure, via brew) ────────────────────────────────────
autoload -U promptinit && promptinit
prompt pure 2>/dev/null

# ── plugins (installed by the Brewfile) ────────────────────────
[[ -f $brew_share/zsh-autosuggestions/zsh-autosuggestions.zsh ]] &&
  source "$brew_share/zsh-autosuggestions/zsh-autosuggestions.zsh"

(( $+commands[fzf] )) && source <(fzf --zsh)   # ctrl-r history, ctrl-t files, alt-c cd

# ── aliases ────────────────────────────────────────────────────
alias ll='ls -lAhG'
alias vim='nvim'

# ── functions ──────────────────────────────────────────────────
# t            — сессия tmux для текущей папки (в $HOME — выбор проекта через fzf)
# t ~/dev/foo  — сессия для указанной папки
t() {
  local dir=${1:-$PWD}
  if [[ -z $1 && $PWD == $HOME ]] && (( $+commands[fzf] )); then
    dir=$(print -l ~/dev/*(/N) | fzf --prompt='project> ') || return
  fi
  dir=${dir:A}
  local name=${${dir:t}//./_}
  tmux has-session -t "=$name" 2>/dev/null || tmux new-session -d -s "$name" -c "$dir"
  if [[ -n $TMUX ]]; then tmux switch-client -t "=$name"
  else tmux attach -t "=$name"; fi
}

# ── machine-local overrides (never committed) ──────────────────
[[ -f $HOME/.zshrc.local ]] && source "$HOME/.zshrc.local"

# syntax highlighting must be sourced last
[[ -f $brew_share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] &&
  source "$brew_share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

unset brew_share
